#!/usr/bin/env bash

set -euo pipefail

require_command() {
    local command_name="$1"
    if ! command -v "$command_name" >/dev/null 2>&1; then
        printf '%s\n' "$command_name is required." >&2
        exit 1
    fi
}

find_root_config() {
    local config configs subvolume
    configs="$(snapper --csvout --no-headers list-configs --columns config,subvolume)"
    while IFS=, read -r config subvolume; do
        if [[ "$subvolume" == / ]]; then
            printf '%s\n' "$config"
            return 0
        fi
    done <<< "$configs"
    return 1
}

synchronize() {
    sudo -n /usr/local/libexec/arch-snapper-limine-sync
}

require_command snapper
require_command sudo
root_config="$(find_root_config || true)"
if [[ -z "$root_config" ]]; then
    printf '%s\n' 'No Snapper configuration manages the root filesystem.' >&2
    exit 1
fi

case "${1:-create}" in
    sync)
        synchronize
        ;;
    create)
        description="${2:-Manual snapshot $(date '+%Y-%m-%d %H:%M:%S')}"
        snapshot_id="$(snapper -c "$root_config" create --print-number --description "$description" --cleanup-algorithm number --read-write)"
        snapshot_id="${snapshot_id//[[:space:]]/}"
        if [[ ! "$snapshot_id" =~ ^[0-9]+$ ]]; then
            printf '%s\n' 'Snapper returned an invalid snapshot ID.' >&2
            exit 1
        fi
        if ! synchronize; then
            printf '%s\n' "Snapshot $snapshot_id was created, but Limine synchronization failed." >&2
            exit 1
        fi
        printf '%s\n' "Snapshot $snapshot_id created and synchronized with Limine."
        ;;
    *)
        printf 'Usage: %s [create [description]|sync]\n' "$0" >&2
        exit 2
        ;;
esac
